{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@effect/ui",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@effect/ui": ["../../src/Index.ts"],
      "@effect/ui/jsx-runtime": ["../../src/JsxRuntime.ts"],
      "@effect/ui/jsx-dev-runtime": ["../../src/JsxDevRuntime.ts"]
    }
  },
  "include": ["app", "shared"]
}
