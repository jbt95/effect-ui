{
  "name": "@effect/ui",
  "version": "0.0.0",
  "private": true,
  "description": "A client-side UI library with Effect-powered components and fine-grained signals.",
  "keywords": [
    "browser",
    "dom",
    "effect",
    "jsx",
    "reactivity",
    "ui"
  ],
  "license": "MIT",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE",
    "README.md",
    "docs/",
    "example/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/Index.js",
  "module": "./dist/Index.js",
  "browser": "./dist/Index.js",
  "types": "./dist/Index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/Index.d.ts",
      "import": "./dist/Index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/JsxRuntime.d.ts",
      "import": "./dist/JsxRuntime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/JsxDevRuntime.d.ts",
      "import": "./dist/JsxDevRuntime.js"
    },
    "./testing": {
      "types": "./dist/Testing.d.ts",
      "import": "./dist/Testing.js"
    },
    "./http": {
      "types": "./dist/Http.d.ts",
      "import": "./dist/Http.js"
    },
    "./legacy": {
      "types": "./dist/Legacy.d.ts",
      "import": "./dist/Legacy.js"
    },
    "./Application": {
      "types": "./dist/Application.d.ts",
      "import": "./dist/Application.js"
    },
    "./Mount": {
      "types": "./dist/Mount.d.ts",
      "import": "./dist/Mount.js"
    },
    "./Component": {
      "types": "./dist/Component.d.ts",
      "import": "./dist/Component.js"
    },
    "./Element": {
      "types": "./dist/Element.d.ts",
      "import": "./dist/Element.js"
    },
    "./Signal": {
      "types": "./dist/Signal.d.ts",
      "import": "./dist/Signal.js"
    },
    "./Resource": {
      "types": "./dist/Resource.d.ts",
      "import": "./dist/Resource.js"
    },
    "./ResourceCache": {
      "types": "./dist/ResourceCache.d.ts",
      "import": "./dist/ResourceCache.js"
    },
    "./Async": {
      "types": "./dist/Async.d.ts",
      "import": "./dist/Async.js"
    },
    "./Lifecycle": {
      "types": "./dist/Lifecycle.d.ts",
      "import": "./dist/Lifecycle.js"
    },
    "./Action": {
      "types": "./dist/Action.d.ts",
      "import": "./dist/Action.js"
    },
    "./Form": {
      "types": "./dist/Form.d.ts",
      "import": "./dist/Form.js"
    },
    "./Ref": {
      "types": "./dist/Ref.d.ts",
      "import": "./dist/Ref.js"
    },
    "./Focus": {
      "types": "./dist/Focus.d.ts",
      "import": "./dist/Focus.js"
    },
    "./Transition": {
      "types": "./dist/Transition.d.ts",
      "import": "./dist/Transition.js"
    },
    "./Http": {
      "types": "./dist/Http.d.ts",
      "import": "./dist/Http.js"
    },
    "./Image": {
      "types": "./dist/Image.d.ts",
      "import": "./dist/Image.js"
    },
    "./Show": {
      "types": "./dist/Show.d.ts",
      "import": "./dist/Show.js"
    },
    "./For": {
      "types": "./dist/For.d.ts",
      "import": "./dist/For.js"
    },
    "./ErrorBoundary": {
      "types": "./dist/ErrorBoundary.d.ts",
      "import": "./dist/ErrorBoundary.js"
    },
    "./Router": {
      "types": "./dist/Router.d.ts",
      "import": "./dist/Router.js"
    },
    "./Route": {
      "types": "./dist/Route.d.ts",
      "import": "./dist/Route.js"
    },
    "./Navigation": {
      "types": "./dist/Navigation.d.ts",
      "import": "./dist/Navigation.js"
    },
    "./Link": {
      "types": "./dist/Link.d.ts",
      "import": "./dist/Link.js"
    },
    "./Virtualizer": {
      "types": "./dist/Virtualizer.d.ts",
      "import": "./dist/Virtualizer.js"
    },
    "./VirtualList": {
      "types": "./dist/VirtualList.d.ts",
      "import": "./dist/VirtualList.js"
    },
    "./VirtualTable": {
      "types": "./dist/VirtualTable.d.ts",
      "import": "./dist/VirtualTable.js"
    },
    "./Testing": {
      "types": "./dist/Testing.d.ts",
      "import": "./dist/Testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run build:lib && vite build",
    "build:lib": "bun run tools/CleanDist.ts && tsc -p tsconfig.build.json",
    "prepack": "bun run build:lib",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:package": "bun run build:lib && tsc -p tsconfig.package.json",
    "lint": "oxlint -c oxlint.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:package": "bun run typecheck:package && bun run tools/PackageSmoke.ts",
    "test:browser": "bun run tools/BrowserSmoke.ts",
    "bench:runtime": "bun run bench/Reactivity.ts",
    "ci": "bun run format:check && bun run typecheck && bun run lint && bun run test && bun run test:package && bun run build"
  },
  "dependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@types/node": "^26.6.5",
    "happy-dom": "^20.14.6",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
